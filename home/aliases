# ── update: upgrade the whole system ────────────────────────────────────────
update() {
  echo "==> System packages"
  sudo pacman -Sy --needed archlinux-keyring || return
  if   command -v yay  &>/dev/null; then yay  -Syu --noconfirm
  elif command -v paru &>/dev/null; then paru -Syu --noconfirm
  else sudo pacman -Syu --noconfirm
  fi

  if command -v flatpak &>/dev/null; then
    echo "==> Flatpak"
    flatpak update --user -y
    sudo flatpak update --system -y
  fi

  if command -v mise &>/dev/null; then
    echo "==> mise runtimes"
    mise self-update --no-plugins 2>/dev/null || true
    mise upgrade
  fi

  if command -v tldr &>/dev/null; then
    echo "==> tldr cache"
    tldr --update &>/dev/null && echo "   refreshed."
  fi

  echo "==> Done."
}

# ── Kubernetes ──────────────────────────────────────────────────────────────
if command -v kubectl &>/dev/null; then
  alias k='kubectl'
  complete -o default -F __start_kubectl k 2>/dev/null

  alias kpf='kubectl port-forward'
  alias kev='kubectl get events --sort-by=.lastTimestamp'
  alias kaa='kubectl get all --all-namespaces'
  alias ktop='kubectl top'
  alias kapi='kubectl api-resources'

  # Tail a pod's logs without knowing its namespace.
  # Usage: klogs <pod> [kubectl logs flags...]
  klogs() {
    if [[ -z "$1" ]]; then
      echo "usage: klogs <pod-name> [kubectl logs flags...]" >&2
      return 2
    fi
    local pod="$1"; shift
    local ns
    ns=$(kubectl get pod -A --field-selector=metadata.name="$pod" \
          -o jsonpath='{.items[0].metadata.namespace}' 2>/dev/null)
    if [[ -z "$ns" ]]; then
      echo "klogs: pod '$pod' not found in any namespace" >&2
      return 1
    fi
    kubectl logs -n "$ns" "$pod" "$@"
  }

  # Chronological events, all namespaces unless you pass -n or -A.
  # Flags pass through: events -n foo, events -w, events --field-selector type=Warning
  events() {
    local args=("$@")
    if ! [[ " ${args[*]} " =~ " -n " || " ${args[*]} " =~ " --namespace " \
         || " ${args[*]} " =~ " -A " || " ${args[*]} " =~ " --all-namespaces " ]]; then
      args=(--all-namespaces "${args[@]}")
    fi
    kubectl get events \
      --sort-by=.lastTimestamp \
      -o custom-columns=NAMESPACE:.metadata.namespace,LASTSEEN:.lastTimestamp,FIRSTSEEN:.firstTimestamp,COUNT:.count,TYPE:.type,REASON:.reason,OBJECT:.involvedObject.name,MESSAGE:.message \
      "${args[@]}"
  }

  # Throwaway netshoot pod for in-cluster network debugging.
  kdebug() {
    kubectl run "debug-${RANDOM}" --rm -it \
      --image=nicolaka/netshoot --restart=Never -- "${@:-sh}"
  }
fi

