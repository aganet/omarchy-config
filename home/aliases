# ── List my own aliases ─────────────────────────────────────────────────────
# myalias           everything defined in this file and ~/.bashrc.local
# myalias kube      only those matching "kube"
# myalias --files   show which file each came from
myalias() {
  local pattern="" show_files=0
  while (( $# )); do
    case "$1" in
      --files) show_files=1 ;;
      *)       pattern="$1" ;;
    esac
    shift
  done

  local files=("${BASH_SOURCE[0]}" "$HOME/.bashrc.local")
  local f
  for f in "${files[@]}"; do
    [[ -f "$f" ]] || continue
    # `grep` may be aliased to rg, so call the real one.
    command grep -nE "^[[:space:]]*alias[[:space:]]+[a-zA-Z_-]+=|&&[[:space:]]+alias[[:space:]]+[a-zA-Z_-]+=" "$f" |
      command sed -E "s|^([0-9]+):.*alias |\1\t|" |
      while IFS=$'\t' read -r lineno aliasdef; do
        [[ $aliasdef == \#* ]] && continue
        [[ -n $pattern && $aliasdef != *"$pattern"* ]] && continue
        if (( show_files )); then
          printf "%-20s %s:%s\n" "${aliasdef%%=*}" "$(basename "$f")" "$lineno"
        else
          echo "$aliasdef"
        fi
      done
  done | sort -u
}

# ── Security scanning ───────────────────────────────────────────────────────
# gitleaks on this repo.
#   secscan-leaks            working tree only (fast)
#   secscan-leaks --all      whole git history (slow)
#   secscan-leaks --redact   hide the secret values
#   secscan-leaks --json F   write findings to F
secscan-leaks() {
  command -v gitleaks &>/dev/null || {
    echo "gitleaks not installed — sudo pacman -S gitleaks" >&2
    return 127
  }
  local args=(detect --source . --verbose --no-banner)
  local out_json=""
  while (( $# )); do
    case "$1" in
      --all)    args+=(--log-opts="--all") ;;
      --redact) args+=(--redact) ;;
      --json)   out_json="$2"; args+=(--report-format=json --report-path="$2"); shift ;;
      *)        args+=("$1") ;;
    esac
    shift
  done
  gitleaks "${args[@]}"
  local rc=$?
  if (( rc == 0 )); then
    echo "✔ no secrets found"
  else
    echo "✘ findings detected (gitleaks exit=$rc)"
    [[ -n "$out_json" ]] && echo "  full report: $out_json"
  fi
  return $rc
}

# Run every scanner that fits what is in this folder. Missing tools are skipped.
secscan() {
  local rc=0
  _secscan_section() { echo; echo "━━ $1 ━━"; }

  _secscan_section "Secrets"
  command -v gitleaks   &>/dev/null && { gitleaks detect --source . --verbose --no-banner --redact || rc=1; }
  command -v trufflehog &>/dev/null && { trufflehog filesystem . --no-update --only-verified 2>/dev/null || rc=1; }

  _secscan_section "SAST (code patterns)"
  command -v semgrep &>/dev/null && { semgrep --config=auto --quiet --error . || rc=1; }

  _secscan_section "Dependencies"
  command -v osv-scanner &>/dev/null && { osv-scanner -r . 2>/dev/null || rc=1; }
  [[ -f package.json ]] && command -v npm   &>/dev/null && { npm audit --omit=dev 2>/dev/null || rc=1; }
  [[ -f Cargo.toml   ]] && command -v cargo &>/dev/null && { cargo audit 2>/dev/null || rc=1; }
  [[ -f go.mod       ]] && command -v govulncheck &>/dev/null && { govulncheck ./... || rc=1; }

  if ls ./*.tf &>/dev/null; then
    _secscan_section "IaC (Terraform)"
    command -v tflint  &>/dev/null && { tflint || rc=1; }
    command -v checkov &>/dev/null && { checkov -d . --quiet --compact || rc=1; }
  fi

  if [[ -f Dockerfile ]] || ls ./*.dockerfile &>/dev/null; then
    _secscan_section "Container (Dockerfile)"
    command -v trivy    &>/dev/null && { trivy config . --quiet || rc=1; }
    command -v hadolint &>/dev/null && { find . -name "Dockerfile*" -exec hadolint {} + || rc=1; }
  fi

  if find . -type f \( -name "*.yaml" -o -name "*.yml" \) -exec grep -l "^kind: " {} + 2>/dev/null | head -1 >/dev/null; then
    _secscan_section "Kubernetes manifests"
    command -v kube-score &>/dev/null && { find . -type f \( -name "*.yaml" -o -name "*.yml" \) -exec kube-score score {} + 2>/dev/null || rc=1; }
    command -v kubescape  &>/dev/null && { kubescape scan . --format pretty-printer 2>/dev/null || rc=1; }
  fi

  echo
  (( rc == 0 )) && echo "✔ all scanners passed" || echo "✘ findings above (rc=$rc)"
  return $rc
}

