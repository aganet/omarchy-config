# Delete local branches whose remote branch is gone.
gprune() {
  git fetch --prune || return
  local stale
  stale=$(git branch -vv | awk '/: gone]/ {print $1}')
  if [[ -z "$stale" ]]; then
    echo "gprune: no stale branches"
    return 0
  fi
  echo "$stale" | xargs git branch -D
}

